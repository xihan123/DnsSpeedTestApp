<Window x:Class="DNSSpeedTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DNSSpeedTester.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="DNS 测速与设置工具"
        Height="780" Width="1180" MinHeight="640" MinWidth="1100"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        BorderThickness="0"
        BorderBrush="{DynamicResource AppBorderBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- 添加窗口阴影效果 -->
    <materialDesign:Card Margin="0" Background="{DynamicResource AppBackgroundBrush}"
                         UniformCornerRadius="12"
                         materialDesign:ElevationAssist.Elevation="Dp3">
        <materialDesign:DialogHost Identifier="RootDialog" CloseOnClickAway="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 自定义标题栏（使用主题感知的背景，浅/深色自动适配） -->
                <materialDesign:ColorZone Grid.Row="0" Mode="Standard"
                                          Background="{DynamicResource AppSurfaceBrush}"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          materialDesign:ElevationAssist.Elevation="Dp0"
                                          CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 标题与图标 -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="16,10">
                            <materialDesign:PackIcon Kind="Dns" Height="32" Width="32" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AppAccentBrush}" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="20">DNS 测速与设置工具</TextBlock>
                        </StackPanel>

                        <!-- 允许拖动窗口 -->
                        <Grid Grid.Column="1" Background="Transparent"
                              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                        <!-- 窗口控制按钮 -->
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                Click="MinimizeButton_Click" ToolTip="最小化"
                                Padding="8" Margin="4">
                            <materialDesign:PackIcon Kind="WindowMinimize" />
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                Click="MaximizeRestoreButton_Click" ToolTip="最大化/还原"
                                Padding="8" Margin="4">
                            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" />
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource MaterialDesignIconButton}"
                                Click="CloseButton_Click" ToolTip="关闭" Foreground="{DynamicResource AppMutedBrush}"
                                Padding="8" Margin="4">
                            <materialDesign:PackIcon Kind="Close" />
                        </Button>
                    </Grid>
                </materialDesign:ColorZone>

                <!-- 主体内容：导航式 TabControl -->
                <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="16"
                            SelectedIndex="0"
                            Background="Transparent" BorderThickness="0">

                    <!-- ============ 测速 ============ -->
                    <TabItem Style="{StaticResource AppNavigationItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <materialDesign:PackIcon Kind="Speedometer" VerticalAlignment="Center" />
                                <TextBlock Text="测速" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 测试工具条 -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="测试域名:" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding TestDomains}"
                                          SelectedItem="{Binding SelectedTestDomain}"
                                          materialDesign:HintAssist.Hint="选择测试域名"
                                          Style="{StaticResource AppComboBox}"
                                          Margin="0,0,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text=" [" />
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="{DynamicResource AppMutedBrush}" />
                                                <TextBlock Text="] " />
                                                <TextBlock Text="{Binding Domain}"
                                                           Foreground="{DynamicResource AppMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="2"
                                        Command="{Binding RefreshRandomDomainCommand}"
                                        Style="{StaticResource AppOutlinedButton}"
                                        ToolTip="刷新随机域名" Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="Refresh" />
                                </Button>

                                <TextBlock Grid.Column="3" Text="协议:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding ProtocolOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Key"
                                          SelectedValue="{Binding SelectedProtocol}"
                                          Style="{StaticResource AppComboBox}"
                                          Width="150" Margin="0,0,16,0" />

                                <Button Grid.Column="6"
                                        Command="{Binding StartTestCommand}"
                                        Style="{StaticResource AppRaisedButton}"
                                        ToolTip="测试所有 DNS 服务器的延迟" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Speedometer" Margin="0,0,8,0" />
                                        <TextBlock Text="开始测速" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="7"
                                        Command="{Binding StopTestCommand}"
                                        Style="{StaticResource AppOutlinedButton}"
                                        ToolTip="停止当前测速">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Stop" Margin="0,0,8,0" />
                                        <TextBlock Text="停止" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Bootstrap 指示 + 进度 + 状态 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="10,3" Margin="0,0,16,0" VerticalAlignment="Center"
                                        Visibility="{Binding BootstrapDns, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BootstrapDns, StringFormat='Bootstrap: {0}'}"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ProgressBar Width="200" Height="5"
                                             Maximum="{Binding TotalCount}"
                                             Value="{Binding TestedCount}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- DNS 服务器结果表格 -->
                            <materialDesign:Card Grid.Row="2" Padding="0"
                                                 Background="{DynamicResource AppSurfaceBrush}"
                                                 materialDesign:ElevationAssist.Elevation="Dp0">
                                <DataGrid ItemsSource="{Binding DnsServers}"
                                          SelectedItem="{Binding SelectedDnsServer}"
                                          Background="{DynamicResource AppSurfaceBrush}"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          BorderThickness="0"
                                          GridLinesVisibility="None"
                                          HeadersVisibility="Column"
                                          RowHeight="46" ColumnHeaderHeight="44"
                                          HorizontalScrollBarVisibility="Auto"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow"
                                               BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFastest}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AppFastestBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AppHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AppSelectionBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell"
                                               BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="36" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <materialDesign:PackIcon Kind="Star"
                                                                             Foreground="{DynamicResource StatusSuccessBrush}"
                                                                             Width="18" Height="18"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             ToolTip="本次最快"
                                                                             Visibility="{Binding IsFastest, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="DNS 服务器名称" Binding="{Binding Name}" Width="*"
                                                            MinWidth="140" />
                                        <DataGridTextColumn Header="主 DNS 地址" Binding="{Binding PrimaryIP}" Width="130" />
                                        <DataGridTextColumn Header="备用 DNS 地址" Binding="{Binding SecondaryIP}"
                                                            Width="130" />
                                        <DataGridTextColumn Header="支持协议" Width="120"
                                                            Binding="{Binding Converter={StaticResource CapabilitiesConverter}}" />
                                        <DataGridTextColumn Header="延迟 (ms)"
                                                            Binding="{Binding LatencyDisplay}"
                                                            Width="150">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell"
                                                       BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                                    <Setter Property="ToolTip" Value="{Binding StatusDetail}" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Foreground"
                                                            Value="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                                            Command="{Binding DataContext.RemoveCustomDnsCommand,
                                                                     RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="删除自定义 DNS"
                                                            Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                    <!-- ============ 系统 DNS ============ -->
                    <TabItem Style="{StaticResource AppNavigationItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <materialDesign:PackIcon Kind="Lan" VerticalAlignment="Center" />
                                <TextBlock Text="系统 DNS" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>

                        <StackPanel Margin="16">
                            <TextBlock Text="网络适配器" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding NetworkAdapters}"
                                          SelectedItem="{Binding SelectedNetworkAdapter}"
                                          DisplayMemberPath="Description"
                                          materialDesign:HintAssist.Hint="选择网络适配器"
                                          Style="{StaticResource AppComboBox}"
                                          Margin="0,0,16,0" />
                                <Button Grid.Column="1"
                                        Command="{Binding RunNetworkDiagnosticsCommand}"
                                        Style="{StaticResource AppOutlinedButton}"
                                        ToolTip="网络适配器诊断" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="NetworkOutline" />
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding SelfCheckCommand}"
                                        Style="{StaticResource AppOutlinedButton}"
                                        ToolTip="QUIC/DoQ 自检">
                                    <materialDesign:PackIcon Kind="ShieldCheck" />
                                </Button>
                            </Grid>

                            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                                 Background="{DynamicResource AppSurfaceBrush}"
                                                 materialDesign:ElevationAssist.Elevation="Dp0">
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="当前获取方式: " />
                                        <Run Text="{Binding SelectedNetworkAdapter.IsDhcpEnabled, Mode=OneWay}"
                                             FontWeight="SemiBold" />
                                        <Run Text="  (True=自动获取/DHCP)" Foreground="{DynamicResource AppMutedBrush}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,8,0,4" Text="当前适配器 DNS:" />
                                    <ItemsControl ItemsSource="{Binding SelectedNetworkAdapter.DnsServers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,8,0,0">
                                        <Run Text="将应用的 DNS 服务器: " />
                                        <Run
                                            Text="{Binding SelectedDnsServer.Name, Mode=OneWay, TargetNullValue=（请在“测速”列表中选择一项）}"
                                            FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </materialDesign:Card>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SetDnsCommand}"
                                        Style="{StaticResource AppRaisedButton}"
                                        ToolTip="将所选 DNS 服务器设置到所选网卡" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DnsOutline" Margin="0,0,8,0" />
                                        <TextBlock Text="设置所选 DNS" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetToDhcpCommand}"
                                        Style="{StaticResource AppOutlinedButton}"
                                        ToolTip="恢复为自动获取 DNS (DHCP)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Restore" Margin="0,0,8,0" />
                                        <TextBlock Text="恢复 DHCP" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- ============ 自定义 ============ -->
                    <TabItem Style="{StaticResource AppNavigationItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <materialDesign:PackIcon Kind="PlaylistEdit" VerticalAlignment="Center" />
                                <TextBlock Text="自定义" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Text="自定义 DNS 服务器" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="提示：在“测速”列表中选择一个自定义条目即可载入下方表单进行修改；或直接填写新增。"
                                           Foreground="{DynamicResource AppMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewDnsName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="DNS 名称"
                                             Style="{StaticResource AppTextBox}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPrimaryDns, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="主 DNS 地址"
                                             Style="{StaticResource AppTextBox}" Margin="8,0,8,0" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding NewSecondaryDns, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="备用 DNS 地址 (可选)"
                                             Style="{StaticResource AppTextBox}" Margin="8,0,8,0" />
                                    <Button Grid.Column="3"
                                            Command="{Binding AddCustomDnsCommand}"
                                            Style="{StaticResource AppRaisedButton}"
                                            ToolTip="{Binding AddDnsButtonText}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Margin="0,0,8,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="PlusCircleOutline" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingDns}" Value="True">
                                                                <Setter Property="Kind" Value="ContentSaveOutline" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="{Binding AddDnsButtonText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewDohUrl, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="DoH URL (如: https://example.com/dns-query)"
                                             Style="{StaticResource AppTextBox}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewDotHost, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="DoT Host"
                                             Style="{StaticResource AppTextBox}" Margin="8,0,8,0" />
                                    <TextBox Grid.Column="2" Width="80" HorizontalAlignment="Left"
                                             Text="{Binding NewDotPort, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="DoT端口"
                                             Style="{StaticResource AppTextBox}" Margin="8,0,8,0" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding NewDoqHost, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="DoQ Host"
                                             Style="{StaticResource AppTextBox}" Margin="8,0,8,0" />
                                    <TextBox Grid.Column="4" Width="80" HorizontalAlignment="Left"
                                             Text="{Binding NewDoqPort, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="DoQ端口"
                                             Style="{StaticResource AppTextBox}" Margin="8,0,0,0" />
                                </Grid>

                                <Separator Margin="0,20" />

                                <TextBlock Text="自定义测试域名" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="提示：在“测速”的域名下拉中选择一个自定义域名即可载入下方表单进行修改。"
                                           Foreground="{DynamicResource AppMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewTestDomainName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="域名名称 (如: 我的网站)"
                                             Style="{StaticResource AppTextBox}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewTestDomainValue, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="域名 (如: www.example.com)"
                                             Style="{StaticResource AppTextBox}" Margin="8,0,8,0" />
                                    <Button Grid.Column="2"
                                            Command="{Binding AddTestDomainCommand}"
                                            Style="{StaticResource AppRaisedButton}"
                                            ToolTip="{Binding AddTestDomainButtonText}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Margin="0,0,8,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="PlusCircleOutline" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingTestDomain}"
                                                                         Value="True">
                                                                <Setter Property="Kind" Value="ContentSaveOutline" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="{Binding AddTestDomainButtonText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============ 高级 ============ -->
                    <TabItem Style="{StaticResource AppNavigationItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <materialDesign:PackIcon Kind="Tune" VerticalAlignment="Center" />
                                <TextBlock Text="高级" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>

                        <StackPanel Margin="16">
                            <TextBlock Text="Bootstrap DNS" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="用于解析加密 DNS (DoH/DoT/DoQ) 上游域名的 UDP DNS 服务器；留空则使用系统 DNS。"
                                       Foreground="{DynamicResource AppMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,12" />
                            <TextBox Width="280" HorizontalAlignment="Left"
                                     Text="{Binding BootstrapDns, UpdateSourceTrigger=LostFocus}"
                                     materialDesign:HintAssist.Hint="IP (如: 8.8.8.8)"
                                     Style="{StaticResource AppTextBox}" />

                            <Separator Margin="0,20" />

                            <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="主题模式（跟随系统时会随 Windows 主题自动切换）"
                                       Foreground="{DynamicResource AppMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="浅色" GroupName="Theme"
                                             IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="Light"
                                             Margin="0,0,24,0" />
                                <RadioButton Content="深色" GroupName="Theme"
                                             IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="Dark"
                                             Margin="0,0,24,0" />
                                <RadioButton Content="跟随系统" GroupName="Theme"
                                             IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}"
                                             CommandParameter="System" />
                            </StackPanel>

                            <Separator Margin="0,20" />

                            <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="DNS 测速与设置工具" Margin="0,8,0,0" />
                            <TextBlock Text="支持 UDP/TCP、DoH、DoT、DoQ 四种协议测速，并可一键设置系统 DNS。"
                                       Foreground="{DynamicResource AppMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- 状态栏（主题感知背景） -->
                <materialDesign:ColorZone Grid.Row="2" Mode="Standard" Padding="8"
                                          Background="{DynamicResource AppSurfaceBrush}"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          CornerRadius="0,0,12,12">
                    <DockPanel>
                        <ProgressBar DockPanel.Dock="Right"
                                     IsIndeterminate="True"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Value="0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="16,0" VerticalAlignment="Center" />
                    </DockPanel>
                </materialDesign:ColorZone>
            </Grid>
        </materialDesign:DialogHost>
    </materialDesign:Card>

</Window>